# Nexus Connector Examples Configuration
# Copy this file to .env and add your API keys

# Default provider for examples (openai, anthropic, google, xai, deepseek, ollama)
DEFAULT_PROVIDER=openai

# Default model for the selected provider
DEFAULT_MODEL=gpt-3.5-turbo

# API Keys for different providers
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here
XAI_API_KEY=your-xai-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# Ollama configuration (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# WebSocket server configuration
WEBSOCKET_PORT=8000
WEBSOCKET_HOST=0.0.0.0

# Session configuration
SESSION_TIMEOUT_HOURS=24

# CORS settings (comma-separated origins)
CORS_ORIGINS=*

# Model configurations for each provider
OPENAI_MODELS=gpt-3.5-turbo,gpt-4,gpt-4-turbo
ANTHROPIC_MODELS=claude-3-opus-20240229,claude-3-sonnet-20240229,claude-3-haiku-20240307
GOOGLE_MODELS=gemini-pro,gemini-1.5-pro
XAI_MODELS=grok-1,grok-2
DEEPSEEK_MODELS=deepseek-coder,deepseek-chat
OLLAMA_MODELS=llama2,codellama,mistral

# OpenRouter configuration (for multiple models through one API)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=qwen/qwen3-coder,qwen/qwen-2.5-72b-instruct,meta-llama/llama-3.1-8b-instruct