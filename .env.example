# The Nexus Connector - Environment Variables
# Copy this file to .env and fill in your API keys
# You only need the keys for providers you want to use!

# ============================================
# AI PROVIDERS (pick at least one)
# ============================================

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini - https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AI...

# xAI Grok - https://console.x.ai/
XAI_API_KEY=xai-...

# DeepSeek - https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# OpenRouter (for QwenDevr) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ============================================
# LOCAL AI (no API key needed!)
# ============================================

# Ollama - just install from https://ollama.ai
# Then run: ollama pull llama3.3
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Default provider (openai, anthropic, google, xai, deepseek, ollama)
NEXUS_DEFAULT_PROVIDER=anthropic

# Default model (leave blank for provider default)
NEXUS_DEFAULT_MODEL=

# Workspace directory for file operations
NEXUS_WORKSPACE=./workspace

# Log level (DEBUG, INFO, WARNING, ERROR)
NEXUS_LOG_LEVEL=INFO

# ============================================
# PRODUCTION (optional)
# ============================================

# Redis for distributed sessions
REDIS_URL=redis://localhost:6379

# API key for web server authentication
NEXUS_API_KEY=your-secret-key-here
